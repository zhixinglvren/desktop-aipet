{
  "desktop_aipet": {
    "pet_theme": "robot",
    "pet_visible": true,
    "pet_scale": 1.0,
    "pet_x": 1400,
    "pet_y": 700,
    "check_interval_s": 30,
    "log_retention_days": 7,
    "auto_restart_on_failure": false,
    "nickname": "小新",
    "boss": "老板"
  },
  "monitors": [
    {
      "name": "Nanobot",
      "endpoint": "http://127.0.0.1:18790/health",
      "enabled": true,
      "config_path": "%USERPROFILE%\\.nanobot\\config.json",
      "log_path": "%USERPROFILE%\\.nanobot\\logs\\gateway.log",
      "workspace_key": "agents.defaults.workspace",
      "actions": [
        {
          "label": "启动 Gateway",
          "icon": "🌐",
          "type": "script",
          "path": "%USERPROFILE%\\.nanobot\\start-gateway.bat",
          "window": "hidden",
          "tee_log": true
        },
        {
          "label": "重启 Gateway",
          "icon": "🔄",
          "type": "script_seq",
          "delay_s": 3,
          "steps": [
            {
              "path": "%USERPROFILE%\\.nanobot\\stop-gateway.bat",
              "window": "hidden",
              "wait": true
            },
            {
              "path": "%USERPROFILE%\\.nanobot\\start-gateway.bat",
              "window": "hidden",
              "tee_log": true
            }
          ]
        },
        {
          "label": "打开 WebUI",
          "icon": "🖥️",
          "type": "url",
          "url": "http://127.0.0.1:8765"
        },
        {
          "label": "跳转工作空间",
          "icon": "📂",
          "type": "open_workspace",
          "config_path": "%USERPROFILE%\\.nanobot\\config.json",
          "config_key": "agents.defaults.workspace"
        },
        {
          "label": "微信渠道授权",
          "icon": "💬",
          "type": "powershell",
          "command": "nanobot channels login weixin --force",
          "window": "visible",
          "keep_open": true
        },
        {
          "label": "查看运行配置",
          "icon": "⚙️",
          "type": "popup_file",
          "path": "%USERPROFILE%\\.nanobot\\config.json",
          "title": "Nanobot 运行配置"
        },
        {
          "label": "查看运行日志",
          "icon": "📄",
          "type": "popup_log",
          "title": "Nanobot Gateway 实时日志"
        }
      ]
    }
  ],
