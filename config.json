{
  "desktop_aipet": {
    "pet_theme": "robot",
    "pet_visible": true,
    "pet_scale": 1.0,
    "pet_x": 1400,
    "pet_y": 700,
    "check_interval_s": 30,
    "log_retention_days": 7,
    "auto_restart_on_failure": false,
    "nickname": "小新",
    "boss": "老板"
  },
  "menus": [
    {
      "name": "Nanobot",
      "endpoint": "http://127.0.0.1:18790/health",
      "enabled": true,
      "config_path": "%USERPROFILE%\\.nanobot\\config.json",
      "log_path": "%USERPROFILE%\\.nanobot\\logs\\gateway.log",
      "workspace_key": "agents.defaults.workspace",
      "actions": [
        {
          "label": "启动 Gateway",
          "icon": "🌐",
          "type": "script",
          "path": "%USERPROFILE%\\.nanobot\\start-gateway.bat",
          "window": "hidden",
          "tee_log": true
        },
        {
          "label": "重启 Gateway",
          "icon": "🔄",
          "type": "script_seq",
          "delay_s": 3,
          "steps": [
            {
              "path": "%USERPROFILE%\\.nanobot\\stop-gateway.bat",
              "window": "hidden",
              "wait": true
            },
            {
              "path": "%USERPROFILE%\\.nanobot\\start-gateway.bat",
              "window": "hidden",
              "tee_log": true
            }
          ]
        },
        {
          "label": "打开 WebUI",
          "icon": "🖥️",
          "type": "url",
          "url": "http://127.0.0.1:8765"
        },
        {
          "label": "跳转工作空间",
          "icon": "📂",
          "type": "open_workspace",
          "config_path": "%USERPROFILE%\\.nanobot\\config.json",
          "config_key": "agents.defaults.workspace"
        },
        {
          "label": "微信渠道授权",
          "icon": "💬",
          "type": "powershell",
          "command": "nanobot channels login weixin --force",
          "window": "visible",
          "keep_open": true
        },
        {
          "label": "查看运行配置",
          "icon": "⚙️",
          "type": "popup_file",
          "path": "%USERPROFILE%\\.nanobot\\config.json",
          "title": "Nanobot 运行配置"
        },
        {
          "label": "查看运行日志",
          "icon": "📄",
          "type": "popup_log",
          "title": "Nanobot Gateway 实时日志"
        }
      ]
    },
    {
      "name": "Claude Code",
      "type": "ai_assistant",
      "icon": "🌟",
      "enabled": true,
      "actions": [
        {
          "label": "启动 Claude Code",
          "icon": "🚀",
          "type": "powershell",
          "command": "claude --permission-mode bypassPermissions",
          "window": "visible",
          "keep_open": true
        },
        {
          "label": "打开官网",
          "icon": "🌐",
          "type": "url",
          "url": "https://claude.com/claude-code"
        },
        {
          "label": "跳转工作空间",
          "icon": "📁",
          "type": "open_workspace",
          "path": "%USERPROFILE%\\.claude"
        },
        {
          "label": "查看运行配置",
          "icon": "⚙️",
          "type": "popup_file",
          "path": "%USERPROFILE%\\.claude\\settings.json",
          "title": "Claude Code 运行配置"
        },
        {
          "label": "查看 Agent 配置",
          "icon": "📄",
          "type": "popup_file",
          "path": "%USERPROFILE%\\.claude\\CLAUDE.md",
          "title": "Claude Code Agent 配置"
        }
      ]
    },
    {
      "name": "Codex",
      "type": "ai_assistant",
      "icon": "💠",
      "enabled": true,
      "actions": [
        {
          "label": "启动 Codex",
          "icon": "🚀",
          "type": "powershell",
          "command": "codex",
          "window": "visible",
          "keep_open": true
        },
        {
          "label": "打开官网",
          "icon": "🌐",
          "type": "url",
          "url": "https://github.com/openai/codex"
        },
        {
          "label": "跳转工作空间",
          "icon": "📁",
          "type": "open_workspace",
          "path": "%USERPROFILE%\\.codex"
        },
        {
          "label": "查看运行配置",
          "icon": "⚙️",
          "type": "popup_file",
          "path": "%USERPROFILE%\\.codex\\config.toml",
          "title": "Codex 运行配置"
        },
        {
          "label": "查看 Agent 配置",
          "icon": "📄",
          "type": "popup_file",
          "path": "%USERPROFILE%\\.codex\\AGENTS.md",
          "title": "Codex Agent 配置"
        }
      ]
    },
    {
      "name": "OpenCode",
      "type": "ai_assistant",
      "icon": "⬜",
      "enabled": true,
      "actions": [
        {
          "label": "启动 OpenCode",
          "icon": "🚀",
          "type": "powershell",
          "command": "opencode",
          "window": "visible",
          "keep_open": true
        },
        {
          "label": "打开官网",
          "icon": "🌐",
          "type": "url",
          "url": "https://opencode.ai"
        },
        {
          "label": "跳转工作空间",
          "icon": "📁",
          "type": "open_workspace",
          "path": "%USERPROFILE%\\.config\\opencode"
        },
        {
          "label": "查看运行配置",
          "icon": "⚙️",
          "type": "popup_file",
          "path": "%USERPROFILE%\\.config\\opencode\\opencode.json",
          "title": "OpenCode 运行配置"
        },
        {
          "label": "查看 Agent 配置",
          "icon": "📄",
          "type": "popup_file",
          "path": "%USERPROFILE%\\.config\\opencode\\AGENTS.md",
          "title": "OpenCode Agent 配置"
        }
      ]
    }
  ],
